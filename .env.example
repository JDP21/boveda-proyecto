# Plantilla SIN secretos reales. Copiar a .env (que NO se sube a Git):
#   cp .env.example .env

# WebAuthn: ORIGIN debe coincidir EXACTO con la URL donde se abre el cliente
#   Docker (nginx):     http://localhost:8080
#   Vite (npm run dev): http://localhost:5173
RP_ID=localhost
RP_NAME=Bóveda Segura UD
ORIGIN=http://localhost:8080

CHALLENGE_TTL_SECONDS=300
SESSION_TTL_MINUTES=60
